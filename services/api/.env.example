# ReMind environment configuration
# Copy this file to .env and adjust values for your machine

DATABASE_URL=postgresql+psycopg://remind:remind_dev@localhost:5432/remind
JWT_SECRET=dev-secret-change-in-production-0123456789abcdef
JWT_ALGORITHM=HS256
ENVIRONMENT=development
STORAGE_BACKEND=local
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=6291456
# For cloud previews: STORAGE_BACKEND=supabase; use a PRIVATE bucket.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret-set-in-host-dashboard
# SUPABASE_STORAGE_BUCKET=remind-sources

# Access token lifetime (minutes) and refresh token lifetime (7 days)
TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Optional httpOnly cookie auth (primary path is Authorization: Bearer)
COOKIE_NAME=remind_token
COOKIE_SECURE=false

# Origins allowed by CORS (patient/family/caregiver/clinician apps)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003"]

# Local development uses isolated filesystem storage. Production requires supabase.
STORAGE_BACKEND=local
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=6291456
# Set these only on the API server when STORAGE_BACKEND=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=remind-sources
